# ============================================================================
# .env.example  ——  本地 Node 工具链（迁移脚本 / 测试）变量模板
# 用法: cp .env.example .env  （.env 已被 .gitignore 忽略）
# Cloudflare Workers 的完整变量见 .dev.vars.example
# ⚠️ 不要写入任何真实生产密钥；敏感生产值一律用 Cloudflare Secrets。
# ============================================================================

PAYMENT_MODE=test                 # test | prod
APP_ENV=development

# Supabase（迁移/本地脚本用）
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # ⚠️敏感 仅本地迁移脚本使用，勿提交

# MockProvider（测试）
MOCK_MCH_ID=MOCK_MCH_0001
MOCK_APP_ID=MOCK_APP_0001
MOCK_NOTIFY_SECRET=MOCK_TEST_SECRET_DO_NOT_USE_IN_PROD
